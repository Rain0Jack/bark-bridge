# ============ WebUI / API ============
# WebUI 与 REST API 端口，浏览器访问 http://<主机IP>:8080/
PORT=8080
# 监听地址：0.0.0.0 = 所有网卡；只给本机用可改成 127.0.0.1
HOST=0.0.0.0
# 数据目录：SQLite（用户 / 设备 / 订阅 / 会话签名密钥）都存这里，必须持久化
DATA_DIR=./data

# ============ 首次初始化 ============
# 管理员用户名
ADMIN_USER=admin
# 设置后首次启动会自动创建该管理员；留空则打开 WebUI 由页面引导创建（推荐）
# 密码至少 8 位，创建后请尽快在 WebUI 里改掉
#ADMIN_PASSWORD=change-me-please

# ============ ntfy ============
# 新建订阅时默认使用的 ntfy 地址（每条订阅仍可在 WebUI 里单独改）
NTFY_BASE_URL=http://127.0.0.1:40265
# 新建订阅时默认的 since 回溯窗口，支持 1m / 10m / 1h / all
NTFY_SINCE=1m

# ============ Bark ============
# 新建设备时默认的 Bark 服务器地址（自建 bark-server 时改这里）
BARK_SERVER=https://api.day.app

# ============ 行为调优（一般不用改） ============
# 会话有效期（秒），默认 7 天
#SESSION_TTL=604800
# Bark 正文最大长度，超出截断
#MAX_BODY=2000
# ntfy 断线重连基数（秒），实际按 5/10/20/40/60 指数退避
#RECONNECT_DELAY=5
# 并发推送线程数（一条消息 fanout 到多台设备时使用）
#PUSH_WORKERS=4
# WebUI「日志」页保留的事件条数
#ACTIVITY_SIZE=200
# 1 = 打印每条 HTTP 访问日志（排查问题用）
#ACCESS_LOG=0
# 正文是 JSON 文档时自动展开（ani-rss 等把 JSON 发到 topic 根路径的场景），1=开
#JSON_BODY_PARSE=1
# ntfy 附件/封面是图片时作为 Bark 通知图片转发，1=开
#SEND_IMAGE=1

# ============ WebUI 在线更新（管理员点「更新」从 GitHub 拉取） ============
# 0 = 关闭在线更新入口
#UPDATE_ENABLED=1
# 0 = 不在启动后/每 6 小时自动检查（仍可手动点「检查更新」）
#UPDATE_AUTOCHECK=1
# 代码来源仓库与分支（分支也可以填 tag，如 v2.1.0）
#UPDATE_REPO=Rain0Jack/bark-bridge
#UPDATE_BRANCH=main
# 仅特殊部署/测试需要：覆盖提交信息 API 与源码包下载地址
#UPDATE_API_BASE=https://api.github.com
#UPDATE_CODELOAD_BASE=https://codeload.github.com
# 仅特殊部署需要：指定要替换的程序文件（默认就是正在运行的本脚本）
#APP_FILE=/app/bark-bridge.py
# 仅特殊部署需要：WebUI 文件路径（默认与脚本同目录）
#WEBUI_FILE=/app/webui.html

# ============ 从 v1 升级（仅首次启动、空数据库时生效） ============
# 旧版是单设备单 topic，这些变量会被自动迁移成 admin 的「默认设备 + 一条订阅」，
# 迁移完即可删除；之后一切以 WebUI / 数据库为准。
#BARK_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
#NTFY_TOPIC=alerts
#NTFY_TOKEN=tk_xxxxxxxxxxxxxxxxxxxxxxxx
#BARK_GROUP=ntfy
#BARK_LEVEL=
#BARK_ICON=
