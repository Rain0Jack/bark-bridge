# ntfy 服务地址（NAS 上装了 ntfy 且映射了宿主端口时用 127.0.0.1）
NTFY_BASE_URL=http://127.0.0.1:40265

# 要监听的 topic
NTFY_TOPIC=alerts

# ntfy 的 Bearer token（在 ntfy 里用 `ntfy token add` 生成）
NTFY_TOKEN=tk_xxxxxxxxxxxxxxxxxxxxxxxx

# 首次连接的回溯窗口，支持 1m / 10m / all 等
NTFY_SINCE=1m

# Bark 服务器和 Key（Bark App 首页的推送地址里）
BARK_SERVER=https://api.day.app
BARK_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# 通知分组名，iPad 上相同分组会折叠
BARK_GROUP=ntfy

# 固定 Bark 级别：active / timeSensitive / passive / critical
# 留空表示按 ntfy 优先级自动映射（>=4 -> timeSensitive）
#BARK_LEVEL=timeSensitive

# 可选：通知图标 URL
#BARK_ICON=https://example.com/icon.png

# 正文最大长度（超出截断）
#MAX_BODY=2000

# ntfy 断线重连间隔（秒）
#RECONNECT_DELAY=5
